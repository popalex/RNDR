# =============================================================================
# RNDR - Image Studio Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication (https://clerk.com)
# 1. Create an application at https://dashboard.clerk.com
# 2. Copy the keys from the "API Keys" page
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs (Clerk handles these automatically via the middleware,
# but you can override them here if you use custom pages)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/studio
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/studio

# -----------------------------------------------------------------------------
# Convex (https://docs.convex.dev)
# Run `npx convex dev` to create a project and get this URL.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# Clerk JWT Issuer Domain — set this in the Convex dashboard (not .env.local):
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-subdomain>.clerk.accounts.dev
# It tells Convex which JWT issuer to trust for ctx.auth.getUserIdentity().
# CLERK_JWT_ISSUER_DOMAIN=https://<your-subdomain>.clerk.accounts.dev

# -----------------------------------------------------------------------------
# Generation backend selector
# Controls which back-end the Studio uses to call fal.ai.
#
#   "convex"     (default) — Convex Action; no Docker required.
#                            FAL_KEY must be set via:
#                              pnpm dlx convex env set FAL_KEY <your-key>
#
#   "ai-service"           — Docker ai-service; requires the container to be
#                            running and AI_SERVICE_URL / AI_SERVICE_SECRET set.
#                            FAL_KEY must be set here (used by the container).
#
# See README §"Switching Backends" for a full comparison.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GENERATION_BACKEND=convex

# -----------------------------------------------------------------------------
# fal.ai (https://fal.ai)
# API key from https://fal.ai/dashboard/keys
#
# For "convex" backend: set via `pnpm dlx convex env set FAL_KEY …` instead.
# For "ai-service" backend: set it here.
# -----------------------------------------------------------------------------
FAL_KEY=your_fal_api_key_here

# -----------------------------------------------------------------------------
# AI Service  (only needed when NEXT_PUBLIC_GENERATION_BACKEND=ai-service)
# -----------------------------------------------------------------------------
# URL where the Docker-based AI service is running
# In development: http://localhost:3001
# In production: set to your deployed service URL
AI_SERVICE_URL=http://localhost:3001

# Shared secret between the web app and AI service (used for request auth)
AI_SERVICE_SECRET=change_me_in_production
