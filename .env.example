# =============================================================================
# RNDR - Image Studio Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Convex (https://docs.convex.dev)
# -----------------------------------------------------------------------------
# Your Convex deployment URL - found in the Convex dashboard
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# -----------------------------------------------------------------------------
# fal.ai (https://fal.ai)
# -----------------------------------------------------------------------------
# API key from https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# -----------------------------------------------------------------------------
# AI Service
# -----------------------------------------------------------------------------
# URL where the Docker-based AI service is running
# In development: http://localhost:3001
# In production: set to your deployed service URL
AI_SERVICE_URL=http://localhost:3001

# Shared secret between the web app and AI service (used for request auth)
AI_SERVICE_SECRET=change_me_in_production

# -----------------------------------------------------------------------------
# Authentication (Clerk - https://clerk.com)
# Optional: only required when enabling user accounts
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
